{
  "name": "@portfolio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && wrangler dev --config apps/api/wrangler.toml",
    "build": "cd ../.. && wrangler deploy --dry-run --config apps/api/wrangler.toml --outdir=apps/api/dist",
    "deploy": "cd ../.. && wrangler deploy --config apps/api/wrangler.toml",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: api (no linter configured yet)'",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@portfolio/shared": "*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.103.0"
  }
}
