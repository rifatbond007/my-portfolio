# Portfolio monorepo — single source of truth for local env.
# Copy to .env and fill in real values. .env is gitignored.
#
# Vite (apps/web) reads any VITE_* key from this file at build/dev time.
# Wrangler (apps/api) reads both VITE_* and non-VITE_* keys from .dev.vars
# at the cwd when running `wrangler dev`. To avoid two files, run
# `npm run dev` from the repo root — turbo launches both Vite and Wrangler
# with cwd = repo root, so they share this single .env file.
#
# For production, secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY,
# CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL) are set via `wrangler secret put`,
# not via this file.

# ─── Frontend (Vite) ───────────────────────────────────────────────────────

# API origin (no trailing slash). Use the deployed Workers URL or custom domain.
VITE_API_BASE_URL=https://portfolio-api.your-subdomain.workers.dev

# Cloudflare Turnstile site key (public). dash.cloudflare.com → Turnstile.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Backend (Cloudflare Worker) ────────────────────────────────────────────
# These are NOT used by Vite (no VITE_ prefix) and only matter for
# `wrangler dev` locally. In production, set them via `wrangler secret put`.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=abdullah.al.rifat2239@gmail.com
CONTACT_FROM_EMAIL=Portfolio <noreply@yourdomain.com>
